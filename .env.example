# Copy to ~/.localelock/.env (recommended) or ./.env - never commit real values.

# --- ClickHouse (catalog, evidence and release state) ------------------------
# ClickHouse Cloud: host from the service page, port 8443, secure true.
# Local development: 127.0.0.1, port 8123, secure false.
CLICKHOUSE_HOST=<service>.<region>.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=localelock
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<password>

# The identity the ADK agent uses through the official mcp-clickhouse server.
# Create it read-only; it holds only GRANT SELECT and runs
# with readonly=1, so writes are refused by ClickHouse itself. If unset, the
# app user is reused and /health reports that as a warning.
CLICKHOUSE_AGENT_USER=localelock_agent
CLICKHOUSE_AGENT_PASSWORD=<password>

# --- Gemini (Gemini Enterprise Agent Platform, formerly Vertex AI) -----------
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-service-account.json
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# --- Local runtime -----------------------------------------------------------
# The official Python MCP server. Defaults to backend/.venv/bin/mcp-clickhouse.
MCP_CLICKHOUSE_BIN=
PORT=8787

# --- Demo controls -----------------------------------------------------------
# Required for POST /admin/seed. Reset needs it only when RESET_REQUIRES_KEY=true.
DEMO_ADMIN_KEY=<random-string>
RESET_REQUIRES_KEY=false

# Public-demo cost caps.
RUN_LIMIT_PER_CALLER=5
RUN_LIMIT_GLOBAL=40
RESET_LIMIT_PER_CALLER=10

# Shown on /judge as the source link; deploy.sh falls back to the git remote.
PUBLIC_REPO_URL=
